# Grafana Configuration
GRAFANA_URL=https://grafana.example.com
GRAFANA_USER=report-user
GRAFANA_PASSWORD=your-password-here
# Prefer a Grafana service-account token when possible (skips form login):
# GRAFANA_TOKEN=glsa_xxxxxxxx
GRAFANA_ORG_ID=1

# API authentication (required for /{uid} and /queue). Comma-separated keys.
API_KEYS=replace-with-long-random-api-key

# Email Backend (smtp or sendgrid)
EMAIL_BACKEND=smtp
REPORTS_EMAIL_ENABLED=true
EMAIL_FROM=Grafana Reports <reports@example.com>

# SMTP Configuration (if EMAIL_BACKEND=smtp)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
# starttls | ssl | none  (credentials require starttls or ssl)
SMTP_TLS_MODE=starttls

# SendGrid Configuration (if EMAIL_BACKEND=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_REPLY_TO=

# Email Templates
EMAIL_TEMPLATE_MODE=plain
EMAIL_TEMPLATE_HTML_PATH=
EMAIL_TEMPLATE_IMAGES_DIR=

# PDF Rendering
PDF_OUTDIR=./
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
WAIT_EXTRA_MS=5000
PDF_LANDSCAPE=true
PDF_PAPER_FORMAT=A4
# auto | a4 | css | paged (paged = multi-page breaks between panels)
PDF_SIZE_MODE=paged
PDF_MAX_INCH=200.0
PDF_CSS_PX_PER_IN=96.0
# 0 = auto (viewport_width / 1.414 ≈ A4 landscape ratio)
PDF_PAGE_HEIGHT_PX=0
PDF_DEVICE_SCALE_FACTOR=2
PDF_THEME=light
PDF_MEDIA=screen
PDF_MAX_VIEWPORT_HEIGHT=30000
PDF_FAST_MODE=true
READY_TIMEOUT_MS=180000

# Rendering Options
RENDER_LOCALE=en-US
RENDER_TIMEZONE=Europe/Prague
DEBUG_RENDER=false
DEBUG_SCREENSHOT=false
KIOSK_MODE=1
FORCE_KIOSK_CSS=true

# Other
DEFAULT_TZ=Europe/Prague
RUN_ALL_CONCURRENCY=2
QUEUE_MAX_PENDING=10
LOG_LEVEL=INFO
REPORTS_CONFIG_PATH=config.yml
